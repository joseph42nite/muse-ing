# Cashfree (https://merchant.cashfree.com -> Developers -> API Keys)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# "sandbox" while testing, "production" when live
CASHFREE_ENV=sandbox

# Public base URL used in generated links, e.g. https://tickets.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# YouTube Data API v3 (Google Cloud Console -> Enabled APIs -> YouTube Data API v3 -> Credentials -> API Key)
# Enables live real-time YouTube search for karaoke backing tracks & lyrics
YOUTUBE_API_KEY=

# Optional: where the SQLite database file lives (default ./data/muse.db)
# DATABASE_PATH=

# Demo data (seeded artists/gigs, password "artist123") is on in development and off in production.
# Force it either way with true/false. Only enable in production for a throwaway demo deployment.
# SEED_DEMO_DATA=

# Admin panel host (proxy.ts). Defaults to admin.muse-ing.in,admin.localhost.
# ADMIN_HOSTS=admin.muse-ing.in,admin.localhost
# Set to send /admin on the main site to the admin host.
# ADMIN_ORIGIN=https://admin.muse-ing.in

# Business details on /terms, /privacy, /refunds and /contact. Payment aggregators (Cashfree) check these
# against your KYC, so use the exact registered name, address and phone.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_SUPPORT_PHONE=
# NEXT_PUBLIC_SUPPORT_EMAIL=omkar@hypheningmedia.com
# NEXT_PUBLIC_LEGAL_JURISDICTION=Bengaluru, Karnataka
