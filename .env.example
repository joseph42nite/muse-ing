# Cashfree (https://merchant.cashfree.com -> Developers -> API Keys)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# "sandbox" while testing, "production" when live
CASHFREE_ENV=sandbox

# Public base URL used in generated links, e.g. https://tickets.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# YouTube Data API v3 (Google Cloud Console -> Enabled APIs -> YouTube Data API v3 -> Credentials -> API Key)
# Enables live real-time YouTube search for karaoke backing tracks & lyrics
YOUTUBE_API_KEY=

# Optional: where the SQLite database file lives (default ./data/muse.db)
# DATABASE_PATH=
